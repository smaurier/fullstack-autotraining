    "solution:04": "playwright test --project=solution lab-04",
    "lab:05": "playwright test --project=lab lab-05",
    "solution:05": "playwright test --project=solution lab-05",
    "lab:06": "playwright test --project=lab lab-06",
    "solution:06": "playwright test --project=solution lab-06",
    "lab:07": "playwright test --project=lab lab-07",
    "solution:07": "playwright test --project=solution lab-07",
    "lab:08": "playwright test --project=lab lab-08",
    "solution:08": "playwright test --project=solution lab-08",
    "lab:09": "playwright test --project=lab lab-09",
