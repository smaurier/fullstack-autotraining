{
  "name": "dataviz-animation-labs",
  "version": "1.0.0",
  "private": true,
  "description": "Oracles des labs dataviz et animation. Un graphique se teste sur ce qu'il ENCODE (geometrie, domaine, arbre d'accessibilite), pas sur ce qu'il affiche. Une animation se teste par un deplacement MESURE sous emulation de prefers-reduced-motion.",
  "type": "module",
  "scripts": {
    "outils": "node --test outils/test/*.test.mjs",
    "lab:01": "vitest run --root lab-01-echelle-et-axe",
    "solution:01": "vitest run --root lab-01-echelle-et-axe --config vitest.solution.config.ts",
    "lab:02": "playwright test --project=lab lab-02",
    "solution:02": "playwright test --project=solution lab-02",
    "lab:03": "playwright test --project=lab lab-03",
    "solution:03": "playwright test --project=solution lab-03",
    "lab:04": "playwright test --project=lab lab-04",
    "solution:04": "playwright test --project=solution lab-04",
    "lab:05": "playwright test --project=lab lab-05",
    "solution:05": "playwright test --project=solution lab-05",
    "lab:06": "playwright test --project=lab lab-06",
    "solution:06": "playwright test --project=solution lab-06",
    "tous:labs": "playwright test --project=lab",
    "tous:solutions": "playwright test --project=solution"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@playwright/test": "1.49.1",
    "axe-core": "4.10.2",
    "gsap": "3.13.0",
    "lottie-web": "5.12.2",
    "vitest": "2.1.8"
  }
}
